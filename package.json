{
  "name": "npm-artifact-audit",
  "version": "1.2.4",
  "description": "Treat your npm package as a security artifact: audit execution surface, sizes, dependencies, and diff against the registry before shipping.",
  "author": "Rudra Sankar Ghosh Dastidar",
  "main": "src/index.js",
  "bin": {
    "npm-artifact-audit": "bin/cli.js",
    "npm-publish-guard": "bin/cli.js",
    "publish-guard": "bin/cli.js"
  },
  "type": "commonjs",
  "scripts": {
    "prepublishOnly": "node bin/cli.js audit --allow-src"
  },
  "keywords": [
    "npm",
    "publish",
    "security",
    "secrets",
    "secret-scanning",
    "secret-detection",
    "supply-chain",
    "cli",
    "devops",
    "npm-publish",
    "pre-publish",
    "leaked-secrets",
    "credentials",
    "env-file",
    "leak-prevention",
    "source-map",
    "publish-safety",
    "github-action"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "tar": "^7.4.3"
  },
  "files": [
    "bin",
    "src",
    "action.yml",
    "action-entrypoint.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/rudrasankarg/npm-artifact-audit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudrasankarg/npm-artifact-audit.git"
  },
  "bugs": {
    "url": "https://github.com/rudrasankarg/npm-artifact-audit/issues"
  }
}
